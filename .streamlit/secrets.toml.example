# Streamlit Secrets Configuration Example
# 
# Copy this file to .streamlit/secrets.toml and add your actual API key
# DO NOT commit secrets.toml to version control (it's in .gitignore)
#
# For Streamlit Cloud deployment:
# 1. Go to your app settings
# 2. Navigate to "Secrets" tab
# 3. Paste the content below (with your actual API key)

OPENAI_API_KEY = "sk-your-openai-api-key-here"

